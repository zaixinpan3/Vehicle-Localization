+
+function cost=switchableCost(weights,q,a,mask)
+% Eliminating a quadratic switch yields bounded influence for gross outliers.
+    cost=sum(weights(mask).*a.*q(mask)./(a+q(mask)))+sum(weights(~mask).*a.*log1p(q(~mask)/a));
+end
+
+function mask=boundedMask(names,cfg)
